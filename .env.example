# ============================================================
# Plantilla de variables de entorno - Pomodoro
#
# Copia este archivo como ".env" y ajusta los valores:
#   cp .env.example .env
#
# El archivo .env real no se versiona (está en .gitignore).
# ============================================================

NODE_ENV=production
APP_ENV=production
APP_NAME=Pomodoro

# URL pública donde se publica la aplicación
APP_URL=https://tu-usuario.github.io/tu-repositorio/

# Carpeta local donde se genera la versión de producción
BUILD_DIR=dist
